     property int hyprlandLayoutCount: 0
     property bool isPrimaryScreen: !Quickshell.screens?.length || screenName === Quickshell.screens[0]?.name
 
+    // liveWallpaper: the linuxWallpaperEngine plugin's scene runs live under the login screen. The plugin writes what
+    // to run ({ outputs: { <screen>: { command, clock: { time, date }, blur } } }), dms-greeter-live links it into the
+    // greeter's cache. The greeter starts that engine on the background layer and, once the engine has shown its first
+    // frame, fades its own wallpaper out; the scene's time / date then stand in for the greeter's (clock), and niri
+    // blurs the scene when the plugin says so (blur).
+    readonly property var liveWallpaper: {
+        try {
+            var outputs = JSON.parse(liveWallpaperFile.text() || "{}").outputs || {};
+            var entry = outputs[screenName];
+            return entry && Array.isArray(entry.command) && entry.command.length > 0 ? entry : null;
+        } catch (e) {
+            return null;
+        }
+    }
+    property bool liveSceneShown: false
+    readonly property bool liveSceneBlurred: liveSceneShown && liveWallpaper?.blur === true
+    readonly property bool wallpaperShowsTime: liveSceneShown && liveWallpaper?.clock?.time === true
+    readonly property bool wallpaperShowsDate: liveSceneShown && liveWallpaper?.clock?.date === true
+
+    FileView {
+        id: liveWallpaperFile
+        path: GreetdSettings.configBaseDir ? GreetdSettings.configBaseDir + "/.cache/dms-greeter-live/wallpaper.json" : ""
+        blockLoading: true
+        printErrors: false
+    }
+
+    Process {
+        id: liveWallpaperEngine
+        command: root.liveWallpaper ? root.liveWallpaper.command : []
+        running: command.length > 0
+        stdout: SplitParser {
+            onRead: data => {
+                if (data.indexOf("First frame presented") !== -1)
+                    root.liveSceneShown = true;
+            }
+        }
+        onExited: root.liveSceneShown = false
+    }
+
+    // an engine that hasn't shown anything by then is stopped, the greeter keeps its own wallpaper
+    Timer {
+        interval: 20000
+        running: liveWallpaperEngine.running && !root.liveSceneShown
+        onTriggered: liveWallpaperEngine.running = false
+    }
+
