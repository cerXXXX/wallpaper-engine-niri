#!/usr/bin/env bash
# Re-apply the DMS lock screen patch (video wallpapers, the desktop's Wallpaper Engine video, the
# "Blur Wallpaper" toggle) after dms-shell installs or upgrades. Leaves the files untouched when
# the patch is already in or no longer fits.
shell=/usr/share/quickshell/dms
patchfile=/usr/local/share/dms-lock-video/lock-video-wallpaper.patch
lock="$shell/Modules/Lock/LockScreenContent.qml"
# only the current version of the patch has this; every version has lockVideoWallpaper
marker=lockStreams

if grep -q "$marker" "$lock"; then
    echo "dms-lock-video: already patched"
    exit 0
fi
if grep -q lockVideoWallpaper "$lock"; then
    # only reachable by hand: a package upgrade always brings stock files
    echo "dms-lock-video: an older version of the patch is applied, run install.sh to update it" >&2
    exit 0
fi
if ! patch -d "$shell" -p1 --dry-run -s < "$patchfile" >/dev/null; then
    echo "dms-lock-video: patch no longer applies to this dms-shell version, lock screen left stock" >&2
    exit 0
fi
patch -d "$shell" -p1 -s --no-backup-if-mismatch < "$patchfile"
echo "dms-lock-video: lock screen patched (video wallpapers, engine video and live scenes, blur toggle)"
