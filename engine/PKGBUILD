# Based on the AUR linux-wallpaperengine-git PKGBUILD (Maintainer: Alexis Maiquez <aur@almamu.com>),
# with the patches from this directory applied on top of a pinned upstream commit.
pkgname=linux-wallpaperengine-git
_pkgname=linux-wallpaperengine
_commit=b016d7d1fdcf4e5fd2f9c9fa420a8aaa07fee02d
pkgver=r627.b016d7d1
pkgrel=8
pkgdesc="use steam's wallpaperengine on linux (patched: zero-copy VA-API, video frame pacing, --downscale-to-output, scene text/script fixes, --stream, hidden layers not loaded, first-frame marker)"
arch=('x86_64')
url="https://github.com/Almamu/linux-wallpaperengine"
license=('GPL-3.0-only')
depends=('lz4' 'ffmpeg' 'mpv' 'glfw' 'glew' 'freeglut' 'libpulse' 'libcups' 'at-spi2-core' 'nss' 'libxcomposite' 'libxdamage' 'nspr')
makedepends=('git' 'cmake' 'sdl2' 'glm' 'wayland-protocols' 'xorg-xrandr')
provides=("linux-wallpaperengine")
source=("${pkgname}::git+https://github.com/Almamu/linux-wallpaperengine.git#commit=${_commit}"
        "0001-perf-pass-the-Wayland-display-to-mpv-so-VA-API-decod.patch"
        "0002-fix-don-t-let-mpv-sleep-inside-the-render-loop.patch"
        "0003-perf-render-video-wallpapers-at-the-video-s-frame-ra.patch"
        "0004-perf-add-downscale-to-output-to-render-big-wallpaper.patch"
        "0005-fix-scene-clocks-compose-layers-and-property-scripts.patch"
        "0006-feat-stream-renders-without-a-window-and-streams-the.patch"
        "0007-perf-don-t-load-scene-layers-that-stay-hidden-let-us.patch"
        "0008-feat-print-First-frame-presented-once-the-compositor.patch"
        "0009-feat-eco-holds-the-wallpaper-still-and-shows-a-frame.patch"
        "0010-fix-ropetrail-draws-a-trail-behind-each-particle-ins.patch")
