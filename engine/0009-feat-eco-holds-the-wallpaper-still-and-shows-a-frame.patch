+void VideoDriver::holdTime (bool hold) {
+    if (hold == this->m_timeHeld) {
+	return;
+    }
+
+    if (hold) {
+	this->m_heldAt = this->getClockTime ();
+    } else {
+	this->m_heldFor += this->getClockTime () - this->m_heldAt;
+    }
+
+    this->m_timeHeld = hold;
